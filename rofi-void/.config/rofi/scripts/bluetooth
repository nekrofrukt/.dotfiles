#!/usr/bin/env python3

import subprocess
import os
from typing import List, Dict

bluetooth_icon = " Bluetooth"

# 🔧 Put your devices here (MAC + label)
DEVICES: Dict[str, str] = {
    "AC:80:0A:16:10:39": " WH-1000XM5",
    "D3:20:AF:63:F0:96": "󰍽 M720",
    "E9:F7:FE:C0:78:D1": "󰌌 Keychron K3",
}


def run(cmd: List[str]) -> str:
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()


def is_connected(mac: str) -> bool:
    output = run(["bluetoothctl", "info", mac])
    return "Connected: yes" in output


def connect(mac: str):
    subprocess.run(["bluetoothctl", "connect", mac])


def disconnect(mac: str):
    subprocess.run(["bluetoothctl", "disconnect", mac])


def toggle(mac: str):
    if is_connected(mac):
        disconnect(mac)
    else:
        connect(mac)

def main_menu() -> str:
    options = []

    display_to_mac = {}

    for mac, name in DEVICES.items():
        status = "" if is_connected(mac) else ""
        display = f"{name} {status}"
        options.append(display)
        display_to_mac[display] = mac

    menu = "\n".join(options)

    result = subprocess.run(
        [
            "rofi",
            "-dmenu",
            "-p", "Bluetooth",
            "-normal-window",
            "-theme", os.path.expanduser("~/.config/rofi/styles/bluetooth.rasi"),
        ],
        input=menu,
        capture_output=True,
        text=True,
    ).stdout.strip()

    return result, display_to_mac

def main():
    selected, mapping = main_menu()

    if not selected:
        return

    mac = mapping.get(selected)

    if not mac:
        return

    toggle(mac)

if __name__ == "__main__":
    main()
