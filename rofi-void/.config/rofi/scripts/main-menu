#!/usr/bin/env python3

import subprocess
import os
from typing import List, Tuple

ICON_COLOR = "#a9b1d6"

blt_glyph = "󰂯"
vpn_glyph = "󰦝"
ssh_glyph = "󰒍"
todo_glyph = "󰄲"
pwr_glyph = ""
app_glyph = "󰀻"

spt_icon = "󰓇 Spotify"
nom_icon = "󰑬 Nom"

APPLICATIONS = [spt_icon, nom_icon]

MENU_ITEMS: List[Tuple[str, str]] = [
    ("Bluetooth", blt_glyph),
    ("Apps", app_glyph),
    ("Add a todo", todo_glyph),
    ("SSH", ssh_glyph),
    ("VPN", vpn_glyph),
    ("Power", pwr_glyph),
]


def row(label: str, glyph: str = None) -> str:
    if glyph:
        return f"{label}\0icon\x1f<span color=\"{ICON_COLOR}\">{glyph}</span>"
    return label


def show_rofi(options: List[str], theme: str = None, prompt: str = "", mesg: str = "") -> str:
    menu = "\n".join(options)
    cmd = [
        "rofi", "-dmenu", "-normal-window", "-show-icons", "true", "-i",
    ]
    if theme:
        cmd.extend(["-theme", os.path.expanduser(f"~/.config/rofi/styles/{theme}.rasi")])
    else:
        cmd.extend(["-theme-str", "element-icon { size: 24px; padding: 6px 10px; }"])
    if prompt:
        cmd.extend(["-p", prompt])
    if mesg:
        cmd.extend(["-mesg", mesg])
    result = subprocess.run(cmd, input=menu, capture_output=True, text=True).stdout.strip()
    return result


def run_cmd(cmd: List[str]):
    subprocess.run(cmd)


def main():
    selected = show_rofi([row(label, glyph) for label, glyph in MENU_ITEMS])

    if not selected:
        return

    if selected == "Bluetooth":
        run_cmd([os.path.expanduser("~/.config/rofi/scripts/bluetooth")])

    elif selected == "Apps":
        sub = show_rofi(APPLICATIONS, theme="apps")
        if not sub:
            return
        actions = {
            spt_icon: ["foot", "-e", "spotify_player"],
            nom_icon: ["foot", "-e", "nom"],
        }
        cmd = actions.get(sub)
        if cmd:
            run_cmd(cmd)

    elif selected == "Add a todo":
        run_cmd([os.path.expanduser("~/.config/rofi/scripts/notes")])

    elif selected == "SSH":
        run_cmd(["rofi", "-show", "ssh"])

    elif selected == "VPN":
        run_cmd([os.path.expanduser("~/.config/rofi/scripts/vpn")])

    elif selected == "Power":
        run_cmd([os.path.expanduser("~/.config/rofi/scripts/power-sway")])


if __name__ == "__main__":
    main()
