#!/usr/bin/env python3

import subprocess
import os
from typing import List

blt_icon = "󰂯 Bluetooth"
vpn_icon = "󰦝 VPN"
ssh_icon = " SSH"
spt_icon = "󰓇 Spotify"
nom_icon = "󰑬 Nom"
nts_icon = " Notes"
pwr_icon = " Power"
util_icon = "󱁤 Utilities"
app_icon = "󰀻 Apps"

UTILITIES = [blt_icon, vpn_icon, ssh_icon]
APPLICATIONS = [spt_icon, nom_icon]


def show_rofi(options: List[str], theme: str = "utils", prompt: str = "", mesg: str = "") -> str:
    menu = "\n".join(options)
    cmd = [
        "rofi", "-dmenu", "-normal-window",
        "-theme", os.path.expanduser(f"~/.config/rofi/styles/{theme}.rasi"),
    ]
    if prompt:
        cmd.extend(["-p", prompt])
    if mesg:
        cmd.extend(["-mesg", mesg])
    result = subprocess.run(cmd, input=menu, capture_output=True, text=True).stdout.strip()
    return result


def run_cmd(cmd: List[str]):
    subprocess.run(cmd)


def main():
    selected = show_rofi(
        [util_icon, app_icon, nts_icon, pwr_icon],
    )

    if not selected:
        return

    if selected == util_icon:
        sub = show_rofi(UTILITIES, theme="bluetooth")
        if not sub:
            return
        actions = {
            blt_icon: [os.path.expanduser("~/.config/rofi/scripts/bluetooth")],
            vpn_icon: [os.path.expanduser("~/.config/rofi/scripts/vpn")],
            ssh_icon: ["rofi", "-show", "ssh"],
        }
        cmd = actions.get(sub)
        if cmd:
            run_cmd(cmd)

    elif selected == app_icon:
        sub = show_rofi(APPLICATIONS, theme="apps")
        if not sub:
            return
        actions = {
            spt_icon: ["foot", "-e", "spotify_player"],
            nom_icon: ["foot", "-e", "nom"],
        }
        cmd = actions.get(sub)
        if cmd:
            run_cmd(cmd)

    elif selected == nts_icon:
        run_cmd([os.path.expanduser("~/.config/rofi/scripts/notes")])

    elif selected == pwr_icon:
        run_cmd([os.path.expanduser("~/.config/rofi/scripts/power-sway")])


if __name__ == "__main__":
    main()
