#!/usr/bin/env python3

import subprocess
import os
from typing import Tuple

vpn_icon = "NordVPN"


def run(cmd: list[str]) -> str:
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()


def is_connected() -> bool:
    output = run(["nordvpn", "status"])
    return "Connected" in output


def connect():
    subprocess.run(["nordvpn", "c"])


def disconnect():
    subprocess.run(["nordvpn", "d"])


def toggle():
    if is_connected():
        disconnect()
    else:
        connect()


def main_menu() -> str:
    status = "" if is_connected() else ""
    display = f"{vpn_icon} {status}"

    result = subprocess.run(
        [
            "rofi",
            "-dmenu",
            "-p", "VPN",
            "-theme", os.path.expanduser("~/.config/rofi/styles/vpn.rasi"),
        ],
        input=display,
        capture_output=True,
        text=True,
    ).stdout.strip()

    return result


def main():
    selected = main_menu()

    if not selected:
        return

    toggle()


if __name__ == "__main__":
    main()
