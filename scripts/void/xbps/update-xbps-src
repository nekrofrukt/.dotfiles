#!/bin/bash
set -euo pipefail

VOIDPACKAGES="$HOME/src/void-packages"
CONFIG="$HOME/.dotfiles/scripts/void/xbps/packages.conf"

if [ ! -f "$CONFIG" ]; then
    echo "Config not found: $CONFIG"
    exit 1
fi

check_running() {
    IFS=',' read -ra names <<< "$1"
    for name in "${names[@]}"; do
        name=$(echo "$name" | xargs)  # trim whitespace
        if pgrep -x "$name" >/dev/null 2>&1; then
            echo "  ERROR: $name is running. Please close it first."
            return 1
        fi
    done
    return 0
}

# Check for updates
UPDATES=()
while IFS='|' read -r pkgname source_type source_args distfile_pattern running_check; do
    [[ "$pkgname" =~ ^#.*$ || -z "$pkgname" ]] && continue

    template="$VOIDPACKAGES/srcpkgs/$pkgname/template"
    if [ ! -f "$template" ]; then
        echo "Template not found: $pkgname"
        continue
    fi

    current=$(grep '^version=' "$template" | cut -d= -f2)

    case "$source_type" in
        github)
            latest=$(curl -fsSI "https://github.com/$source_args/releases/latest" \
                | tr -d '\r' \
                | grep -i '^location:' \
                | rev | cut -d/ -f1 | rev)
            ;;
        *)
            echo "Unknown source type: $source_type"
            continue
            ;;
    esac

    latest_nov="${latest#v}"

    if [ "$latest_nov" != "$current" ]; then
        [ -z "$distfile_pattern" ] && distfile_pattern="${pkgname}-{version}.tar.gz"
        echo "$pkgname: $current -> $latest"
        UPDATES+=("$pkgname|$source_type|$source_args|$current|$latest|$distfile_pattern|${running_check:-}")
    fi
done < "$CONFIG"

if [ ${#UPDATES[@]} -eq 0 ]; then
    echo "All packages are up to date."
    exit 0
fi

# Ask to update
read -rp "Update all packages? Y/n " answer
if [[ ! "$answer" =~ ^[Yy]?$ ]]; then
    echo "Aborted."
    exit 0
fi

# Apply updates
for update in "${UPDATES[@]}"; do
    IFS='|' read -r pkgname source_type source_args current latest distfile_pattern running_check <<< "$update"
    template="$VOIDPACKAGES/srcpkgs/$pkgname/template"

    echo ""
    echo "=== Updating $pkgname: $current -> $latest ==="

    # Check if any related processes are running
    if [ -n "$running_check" ]; then
        if ! check_running "$running_check"; then
            echo "  Skipping $pkgname. Re-run after closing the process."
            continue
        fi
    fi

    case "$source_type" in
        github)
            version="${latest#v}"
            distfile="${distfile_pattern//\{version\}/$version}"
            url="https://github.com/$source_args/releases/download/$latest/$distfile"

            echo "  Downloading $distfile..."
            tmpfile=$(mktemp)
            curl -fSL "$url" -o "$tmpfile" --progress-bar 2>&1
            checksum=$(sha256sum "$tmpfile" | awk '{print $1}')
            rm "$tmpfile"
            echo "  Checksum: ${checksum:0:16}..."

            sed -i "s/^version=.*/version=$version/" "$template"
            sed -i "s/^checksum=.*/checksum=$checksum/" "$template"
            echo "  Template updated."
            ;;
    esac

    echo "  Building..."
    cd "$VOIDPACKAGES"
    ./xbps-src pkg "$pkgname" || { echo "  Build failed!"; continue; }

    # Find where the built package landed
    repo_path=$(find "$VOIDPACKAGES/hostdir/binpkgs" -name "${pkgname}-${version}_*.xbps" -printf '%h\n' 2>/dev/null)
    if [ -z "$repo_path" ]; then
        echo "  Package not found after build. Install manually."
        continue
    fi

    echo "  Installing..."
    if sudo xbps-install --repository="$repo_path" "$pkgname" 2>&1; then
        echo "  Done: ${pkgname}-${version}"
    else
        echo "  Install failed. Run manually:"
        echo "    sudo xbps-install --repository=$repo_path $pkgname"
    fi
done
