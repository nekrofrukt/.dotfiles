prefer-no-csd

animations {
    off
    slowdown 0.4
}

layout {
    gaps 4
    struts {
        left -0
        right -0
        top -0
        bottom -0
    }

    // never, always, on-overflow
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
        width 2

        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        on
        width 2
        
        active-color "#a9b1d6"
        inactive-color "transparent"
        urgent-color "#9b0000"
    }

    shadow {
        off

        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}
