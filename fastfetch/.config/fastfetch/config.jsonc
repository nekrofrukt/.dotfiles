{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "display": {
    "separator": " "
  },

    "logo": {
        "position": "top",
        "type": "file",
        "source": "~/.config/fastfetch/logo/arch01.txt",
        "padding": {
            "top": 0,
            "bottom": 4,
            "left": 0,
            "right": 0
        }, 
        "color": {
            "1": "blue",
            "2": "green"
        }
    },

  "modules": [
    {"key": "os       →", "type": "os"},
    {"key": "kernel   →", "type": "kernel"},
    {"key": "age      →", "type": "command", "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"},
    "break",
    {"key": "wm       →", "type": "wm"},
    {"key": "pkg      →", "type": "packages"},
    {"key": "terminal →", "type": "terminal"},
    {"key": "shell    →", "type": "shell"},
    "break",
    {"key": "host     →", "type": "host"},
    {"key": "cpu      →", "type": "cpu"},
    {"key": "memory   →", "type": "memory"},
    {"key": "uptime   →", "type": "uptime"},
    "break",
	{"key": "{#35}{#keys}", "type": "colors", "symbol": "circle"}

  ]
}
