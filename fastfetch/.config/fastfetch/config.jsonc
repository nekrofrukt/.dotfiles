{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "display": {
    "separator": " "
  },

  "logo": {
      "type": "auto",
      "padding": {
          "top": 1,
          "bottom": 0,
          "left": 1,
          "right": 5
      }
  },

    /*"logo": {
        "position": "top",
        "type": "file",
        "source": "~/.config/fastfetch/logo/arch01.txt",
        "padding": {
            "top": 0,
            "bottom": 4,
            "left": 0,
            "right": 0
        }, 
        "color": {
            "1": "blue",
            "2": "green"
        }
